{
  "name": "@sajam/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/build-starters.ts && vp dev",
    "build": "tsc --noEmit && bun src/build-starters.ts && vp build && vp build --ssr src/prerender.tsx --outDir .prerender && bun .prerender/prerender.js",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sajam/ui": "workspace:*",
    "lucide-react": "1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fflate": "0.8.3",
    "tailwindcss": "4.3.3"
  }
}
