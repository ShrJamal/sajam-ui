{
  "name": "@sajam/ui",
  "version": "0.1.0",
  "description": "Reusable React components built with Base UI and Tailwind CSS.",
  "keywords": [
    "base-ui",
    "components",
    "design-system",
    "react",
    "tailwindcss"
  ],
  "license": "MIT",
  "author": "Sajam",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/components/ui/*.d.ts",
      "default": "./dist/components/ui/*.js"
    },
    "./hooks/use-mobile": {
      "types": "./dist/hooks/use-mobile.d.ts",
      "default": "./dist/hooks/use-mobile.js"
    },
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./sources/*.css": "./dist/sources/*.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --noEmit && vp pack && tsc -p tsconfig.build.json && bun scripts/preserve-exports.ts && bun scripts/build-sources.ts",
    "typecheck": "tsc --noEmit",
    "size": "bun scripts/size.ts",
    "check": "bun run --cwd ../.. check",
    "prepack": "bun run check && bun run build"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.48.0",
    "react-day-picker": "10.0.1",
    "react-resizable-panels": "4.13.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.3"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    }
  }
}
